# Gravitre backend environment (FastAPI)
# Copy to `.env` and fill in real values. Never commit the real .env.

# Runtime
APP_ENV=dev                      # dev | staging | prod (staging/prod enforce required secrets)

# Supabase (required)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=               # Project Settings → API → anon public key
SUPABASE_SERVICE_ROLE_KEY=       # Project Settings → API → service_role key (keep secret)
SUPABASE_JWT_SECRET=             # Project Settings → API → JWT Secret
# Optional JWT tuning (defaults derived from SUPABASE_URL)
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_LEEWAY_SECONDS=60

# OpenAI (required for AI features: model router, RAG embeddings, fine-tuning)
OPENAI_API_KEY=
# Embedding model + dimension must match the pgvector column dimension.
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# AI governance / safety (enforced at the ModelRouter chokepoint)
DISABLE_AI=false                      # global LLM killswitch (no redeploy needed)
AI_RATE_LIMIT_PER_MIN=0               # per-org LLM calls/min; 0 disables the limiter
AI_HARD_BUDGET_ENABLED=true           # block calls once period ai_credits cap is hit (default on)
AI_BUDGET_OVERAGE_MULTIPLIER=2.0      # cap = ai_credits_included * this multiplier
AI_MODERATION_ENABLED=true            # Disable only for dev/internal deployments. Always true in production.
AI_MODERATION_MODEL=omni-moderation-latest
AI_PII_REDACTION_ENABLED=true         # redact email/SSN/card/phone before sending to a provider
# Model selection is handled by MODEL_TIERS and TASK_COMPLEXITY in config.py.

# Multi-provider failover
ANTHROPIC_API_KEY=                    # Claude (Anthropic console → API keys)
GEMINI_API_KEY=                       # Google Gemini (Google AI Studio)
GOOGLE_API_KEY=                       # Alias for Gemini when GEMINI_API_KEY unset
VOYAGE_API_KEY=                       # Voyage AI embeddings fallback (voyage-3)
VOYAGE_EMBEDDING_ENABLED=false        # Set true only after re-indexing corpus with Voyage. See docs/voyage-reindex-runbook.md
PREFERRED_AI_PROVIDER=openai          # openai | anthropic | gemini | auto
AI_FAILOVER_ENABLED=true              # try other providers when the primary fails
AI_FAILOVER_LOG_LEVEL=warning

# RAG tuning (optional)
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=8

# Background jobs queue (optional). Redis/Upstash URL for the training job queue;
# falls back to an in-process queue when unset.
# REDIS_URL=redis://default:<password>@<host>:<port>
# Circuit breaker state: auto (Redis when REDIS_URL set), memory (dev/test only).
CIRCUIT_BREAKER_BACKEND=auto

# Async agent-job worker (operator durable jobs)
# AGENT_JOB_WORKER_ENABLED=true
# AGENT_JOB_POLL_SECONDS=5

# Phase 6 kill switches (default off)
# DISABLE_EXECUTE=false
# DISABLE_CONNECTORS=false
# DISABLE_INGESTION=false

# Metrics rollup toggle (default off)
# METRICS_ROLLUP_ENABLED=false

# Stripe billing (optional unless billing is enabled)
STRIPE_SECRET_KEY=                    # Stripe Dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=                # Stripe Dashboard → Webhooks → signing secret
STRIPE_PRICE_ID_NODE_MONTHLY=
STRIPE_PRICE_ID_NODE_ANNUAL=
STRIPE_PRICE_ID_CONTROL_MONTHLY=
STRIPE_PRICE_ID_CONTROL_ANNUAL=
STRIPE_PRICE_ID_COMMAND_MONTHLY=
STRIPE_PRICE_ID_COMMAND_ANNUAL=
# Usage-based (metered) billing: name of the Stripe Billing Meter event.
STRIPE_METER_EVENT_NAME=ai_credits_used
# Per-plan metered price IDs (tied to the meter above). When set, they're added
# as an extra subscription/checkout line item so AI overage is billed. Empty =
# flat-rate only. Create these in Stripe and paste the price_... ids.
STRIPE_METERED_PRICE_ID_NODE=
STRIPE_METERED_PRICE_ID_CONTROL=
STRIPE_METERED_PRICE_ID_COMMAND=
# Shared secret for internal cron endpoints (e.g. POST /api/internal/billing/sync-usage).
# Sent as the X-Internal-Secret header by the scheduler; NOT a user JWT.
INTERNAL_API_SECRET=
# In-process usage-sync scheduler interval (seconds); reports metered AI usage to
# Stripe hourly by default. Set 0 to disable (e.g. if using GitHub Action / Railway cron).
USAGE_SYNC_INTERVAL_SECONDS=3600

# Connector secret encryption (required when connectors are enabled in staging/prod)
# CONNECTOR_SECRETS_ENCRYPTION_KEY=   # Fernet key: Fernet.generate_key()
# ENCRYPTION_KEY=                     # AES-256-GCM key (32-byte base64)

# HubSpot OAuth (STA-13 / STA-14)
# HUBSPOT_CLIENT_ID=              # Production HubSpot app
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_SANDBOX_CLIENT_ID=      # Optional staging/sandbox app (falls back to prod if unset)
# HUBSPOT_SANDBOX_CLIENT_SECRET=
# HUBSPOT_APP_ID=                 # STA-16: developer app ID for webhook subscriptions
# HUBSPOT_DEVELOPER_API_KEY=      # STA-16: developer API key (not customer OAuth token)
# API_PUBLIC_URL=https://api.gravitre.app

# Optional storage / ML
# BLOB_READ_WRITE_TOKEN=              # Vercel Blob read/write token
# DATABASE_URL=                       # Optional Postgres URL (Supabase is default)
# ML_DEFAULT_CLASSIFIER=random_forest
# ML_ANOMALY_CONTAMINATION=0.1
# ML_FORECAST_HORIZON=7

# Public app URL (used for Stripe redirects / CORS allowlist)
# NEXT_PUBLIC_APP_URL=https://gravitre.app

# Note: FASTAPI_BASE_URL is a frontend (Vercel) variable — not read by this backend.
# Note: LANGFUSE_* is not used in this codebase.

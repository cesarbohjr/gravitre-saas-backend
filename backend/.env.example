# Gravitre backend environment (FastAPI)
# Copy to `.env` and fill in real values. Never commit the real .env.

# Runtime
APP_ENV=dev                      # dev | staging | prod (staging/prod enforce required secrets)

# Supabase (required)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=               # Project Settings → API → anon public key
SUPABASE_SERVICE_ROLE_KEY=       # Project Settings → API → service_role key (keep secret)
SUPABASE_JWT_SECRET=             # Project Settings → API → JWT Secret
# Optional JWT tuning (defaults derived from SUPABASE_URL)
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_LEEWAY_SECONDS=60

# OpenAI (required for AI features: model router, RAG embeddings, fine-tuning)
OPENAI_API_KEY=
# Embedding model + dimension must match the pgvector column dimension.
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# AI governance / safety (enforced at the ModelRouter chokepoint)
DISABLE_AI=false                      # global LLM killswitch (no redeploy needed)
AI_RATE_LIMIT_PER_MIN=0               # per-org LLM calls/min; 0 disables the limiter
AI_HARD_BUDGET_ENABLED=true           # block calls once period ai_credits cap is hit (default on)
AI_BUDGET_OVERAGE_MULTIPLIER=2.0      # cap = ai_credits_included * this multiplier
AI_MODERATION_ENABLED=true            # Disable only for dev/internal deployments. Always true in production.
AI_MODERATION_MODEL=omni-moderation-latest
AI_PII_REDACTION_ENABLED=true         # redact email/SSN/card/phone before sending to a provider
# Tavily web search for assistant search_web tool (STA-148). Required for external/current-info answers.
TAVILY_API_KEY=
# Slack OAuth — callback: {API_PUBLIC_URL}/api/connectors/oauth/slack/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_APP_ID=
SLACK_SIGNING_SECRET=                 # Slack slash command signature verification (STA-108)
# Model selection is handled by MODEL_TIERS and TASK_COMPLEXITY in config.py.

# Multi-provider failover
ANTHROPIC_API_KEY=                    # Claude (Anthropic console → API keys)
GEMINI_API_KEY=                       # Google Gemini (Google AI Studio)
GOOGLE_API_KEY=                       # Alias for Gemini when GEMINI_API_KEY unset
VOYAGE_API_KEY=                       # Voyage AI embeddings fallback (voyage-3)
VOYAGE_EMBEDDING_ENABLED=false        # Set true only after re-indexing corpus with Voyage. See docs/voyage-reindex-runbook.md
PREFERRED_AI_PROVIDER=openai          # openai | anthropic | gemini | auto
AI_FAILOVER_ENABLED=true              # try other providers when the primary fails
AI_FAILOVER_LOG_LEVEL=warning

# RAG tuning (optional)
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=8

# Background jobs queue (optional). Redis/Upstash URL for the training job queue;
# falls back to an in-process queue when unset.
# REDIS_URL=redis://default:<password>@<host>:<port>
# Circuit breaker state: auto (Redis when REDIS_URL set), memory (dev/test only).
CIRCUIT_BREAKER_BACKEND=auto

# Async agent-job worker (operator durable jobs)
# AGENT_JOB_WORKER_ENABLED=true
# AGENT_JOB_POLL_SECONDS=5

# Phase 6 kill switches (default off)
# DISABLE_EXECUTE=false
# DISABLE_CONNECTORS=false
# DISABLE_INGESTION=false

# Metrics rollup toggle (default off)
# METRICS_ROLLUP_ENABLED=false

# Stripe billing (optional unless billing is enabled)
STRIPE_SECRET_KEY=                    # Stripe Dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=                # Stripe Dashboard → Webhooks → signing secret
# Stripe Connect v2 sample (docs/samples/stripe-connect-v2.md)
STRIPE_CONNECT_THIN_WEBHOOK_SECRET=   # Thin webhook destination signing secret (whsec_...)
STRIPE_CONNECT_SAMPLE_BASE_URL=       # e.g. http://localhost:8000 or your Railway URL
STRIPE_CONNECT_SAMPLE_PLATFORM_FEE_PERCENT=10
# Private connector runtime (STA-98) — org-signed bundles in subprocess sandbox
PRIVATE_CONNECTOR_RUNTIME_ENABLED=true
PRIVATE_CONNECTOR_SANDBOX_TIMEOUT_SEC=10
STRIPE_PRICE_ID_NODE_MONTHLY=
STRIPE_PRICE_ID_NODE_ANNUAL=
STRIPE_PRICE_ID_CONTROL_MONTHLY=
STRIPE_PRICE_ID_CONTROL_ANNUAL=
STRIPE_PRICE_ID_COMMAND_MONTHLY=
STRIPE_PRICE_ID_COMMAND_ANNUAL=
# Usage-based (metered) billing: name of the Stripe Billing Meter event.
STRIPE_METER_EVENT_NAME=ai_credits_used
# Per-plan metered price IDs (tied to the meter above). When set, they're added
# as an extra subscription/checkout line item so AI overage is billed. Empty =
# flat-rate only. Create these in Stripe and paste the price_... ids.
STRIPE_METERED_PRICE_ID_NODE=
STRIPE_METERED_PRICE_ID_CONTROL=
STRIPE_METERED_PRICE_ID_COMMAND=
# Shared secret for internal cron endpoints (e.g. POST /api/internal/billing/sync-usage).
# Sent as the X-Internal-Secret header by the scheduler; NOT a user JWT.
# Required in production/staging — protects internal cron endpoints (billing sync, knowledge sync, schedules).
INTERNAL_API_SECRET=
# Tier 6: Slack/generic webhook for platform CS tenant escalation (optional)
PLATFORM_CS_ESCALATION_WEBHOOK_URL=
# Transactional notification email (swarm completion). Falls back to org email connector when unset.
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=
NOTIFICATION_SMTP_USE_TLS=true
NOTIFICATION_EMAIL_BRAND_NAME=Gravitre
NOTIFICATION_EMAIL_LOGO_URL=
NOTIFICATION_EMAIL_PRIMARY_COLOR=#0091FF
NOTIFICATION_EMAIL_ACCENT_COLOR=#7C3AED
# Approval SLA targets in minutes (mobile countdown; defaults 60 high / 240 medium)
APPROVAL_SLA_MINUTES_HIGH=60
APPROVAL_SLA_MINUTES_MEDIUM=240
# Knowledge sync scheduler (STA-45). 0 = in-process loop disabled (use cron only).
# KNOWLEDGE_SYNC_INTERVAL_SECONDS=3600
# Workflow schedule dispatcher (STA-47). 0 = in-process loop disabled (use cron only).
# WORKFLOW_SCHEDULE_INTERVAL_SECONDS=60
# In-process usage-sync scheduler interval (seconds); reports metered AI usage to
# Stripe hourly by default. Set 0 to disable (e.g. if using GitHub Action / Railway cron).
USAGE_SYNC_INTERVAL_SECONDS=3600

# Connector secret encryption (required when connectors are enabled in staging/prod)
# 32 random bytes as 64 hex chars: node backend/scripts/generate-connector-encryption-key.mjs
# CONNECTOR_SECRETS_ENCRYPTION_KEY=your_64_character_hex_key_here
# ENCRYPTION_KEY=                     # AES-256-GCM key (32-byte base64)

# HubSpot — Legacy public app in developers.hubspot.com → Legacy apps (see docs/integration/HUBSPOT_PLATFORM_SETUP.md)
# HUBSPOT_CLIENT_ID=              # Auth tab → Client ID
# HUBSPOT_CLIENT_SECRET=          # Auth tab → Client secret; also used for webhook signature v3
# HUBSPOT_SANDBOX_CLIENT_ID=      # Optional separate staging app
# HUBSPOT_SANDBOX_CLIENT_SECRET=
# HUBSPOT_APP_ID=                 # STA-16 only: numeric App ID (overview / Auth tab)
# HUBSPOT_DEVELOPER_API_KEY=      # STA-16 only: Developer account Keys (hapikey for webhooks/v3 API — NOT a Private App token)
# API_PUBLIC_URL=https://api.gravitre.app
# Salesforce OAuth (STA-30) — Connected App callback: {API_PUBLIC_URL}/api/connectors/oauth/salesforce/callback
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_SANDBOX_CLIENT_ID=
# SALESFORCE_SANDBOX_CLIENT_SECRET=
# QuickBooks OAuth (STA-33) — callback: {API_PUBLIC_URL}/api/connectors/oauth/quickbooks/callback
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_SANDBOX_CLIENT_ID=
# QUICKBOOKS_SANDBOX_CLIENT_SECRET=
# Jira Cloud OAuth (STA-36) — callback: {API_PUBLIC_URL}/api/connectors/oauth/jira/callback
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# Confluence OAuth (STA-44) — callback: {API_PUBLIC_URL}/api/connectors/oauth/confluence/callback
# Uses JIRA_CLIENT_* by default; optional overrides:
# CONFLUENCE_CLIENT_ID=
# CONFLUENCE_CLIENT_SECRET=
# PagerDuty OAuth (STA-37) — PD redirect: {PUBLIC_APP_URL}/api/auth/callback/pagerduty (proxied to API)
# PAGERDUTY_CLIENT_ID=
# PAGERDUTY_CLIENT_SECRET=
# Notion OAuth (STA-43) — callback: {API_PUBLIC_URL}/api/connectors/oauth/notion/callback
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# Google OAuth — shared "Gravitre OAuth" app (GA4 + Calendar; see docs/integration/GOOGLE_OAUTH.md)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Aliases (optional if GOOGLE_OAUTH_* set):
# GOOGLE_ANALYTICS_CLIENT_ID=
# GOOGLE_ANALYTICS_CLIENT_SECRET=
# Callbacks:
#   {API_PUBLIC_URL}/api/connectors/oauth/google_analytics/callback
#   {API_PUBLIC_URL}/api/connectors/oauth/google_calendar/callback
# NetSuite OAuth (STA-56) — callback: {API_PUBLIC_URL}/api/connectors/oauth/netsuite/callback
# NETSUITE_CLIENT_ID=
# NETSUITE_CLIENT_SECRET=
# NETSUITE_SANDBOX_CLIENT_ID=
# NETSUITE_SANDBOX_CLIENT_SECRET=
# Workday OAuth (STA-59) — callback: {API_PUBLIC_URL}/api/connectors/oauth/workday/callback
# WORKDAY_CLIENT_ID=
# WORKDAY_CLIENT_SECRET=
# WORKDAY_SANDBOX_CLIENT_ID=
# WORKDAY_SANDBOX_CLIENT_SECRET=
# Marketo REST (STA-64) — client credentials per org via connector; optional platform defaults:
# MARKETO_CLIENT_ID=
# MARKETO_CLIENT_SECRET=
# Segment (STA-67) — write key stored per connector via API key field (no platform OAuth)
#
# --- Platform AI (not a connector OAuth app) ---
# ANTHROPIC_API_KEY=                  # Claude models via ModelRouter — not CLAUDE_CLIENT_ID
#
# --- Verified generic OAuth apps (authorization-code + callback) ---
# Redirect URI for each: {API_PUBLIC_URL}/api/connectors/oauth/<vendor>/callback
# Subdomain at connect time: freshdesk, gorgias (OAuth), snowflake (account locator), zendesk (optional OAuth)
# Instance URL at connect: odoo (e.g. https://mycompany.odoo.com)
#
# ZAPIER_CLIENT_ID= / ZAPIER_CLIENT_SECRET=
# MAILCHIMP_CLIENT_ID= / MAILCHIMP_CLIENT_SECRET=
# CONSTANT_CONTACT_CLIENT_ID= / CONSTANT_CONTACT_CLIENT_SECRET=
# HOOTSUITE_CLIENT_ID= / HOOTSUITE_CLIENT_SECRET=   # developer approval required
# XERO_CLIENT_ID= / XERO_CLIENT_SECRET=             # PKCE recommended
# AIRTABLE_CLIENT_ID= / AIRTABLE_CLIENT_SECRET=     # PKCE required
# ASANA_CLIENT_ID= / ASANA_CLIENT_SECRET=
# CLICKUP_CLIENT_ID= / CLICKUP_CLIENT_SECRET=
# FRESHDESK_CLIENT_ID= / FRESHDESK_CLIENT_SECRET=
# INTERCOM_CLIENT_ID= / INTERCOM_CLIENT_SECRET=
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=         # optional; PAT per connector is default for tools
# MONDAY_CLIENT_ID= / MONDAY_CLIENT_SECRET=
# GUSTO_CLIENT_ID= / GUSTO_CLIENT_SECRET=             # partner approval required
# CANVA_CLIENT_ID= / CANVA_CLIENT_SECRET=             # PKCE + Connect partner program
# MICROSOFT365_CLIENT_ID= / MICROSOFT365_CLIENT_SECRET=
# ZENDESK_CLIENT_ID= / ZENDESK_CLIENT_SECRET=         # optional; API token per connector is default
# PKCE required for: AIRTABLE_*, CANVA_*, XERO_* (handled automatically by generic OAuth)
# Plaid (Plaid Link — NOT /api/connectors/oauth/plaid/callback):
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# Snowflake: per-connector account/warehouse/database/schema/role (password or key_pair auth)
#
# --- Per-connector credentials (NOT platform OAuth env vars) ---
# PostgreSQL / MongoDB: connection string on connector create
# AWS S3: access key id + secret access key (+ region, bucket) per connector
# SendGrid / Twilio / Mixpanel / SEMrush / StackAdapt / Apollo / Motion / n8n / BambooHR / Absorb LMS / ADP / Odoo:
#   API key, token, or partner credentials stored encrypted per connector
# Plaid: PLAID_CLIENT_ID + PLAID_SECRET at platform level; Plaid Link UI flow — not OAuth callback
# GitHub tools today: personal access token per connector (GITHUB_CLIENT_* only if enabling OAuth App path)

# Optional storage / ML
# BLOB_READ_WRITE_TOKEN=              # Vercel Blob read/write token
# DATABASE_URL=                       # Optional Postgres URL (Supabase is default)
# ML_DEFAULT_CLASSIFIER=random_forest
# ML_ANOMALY_CONTAMINATION=0.1
# ML_FORECAST_HORIZON=7

# Public app URL (used for Stripe redirects / CORS allowlist)
# NEXT_PUBLIC_APP_URL=https://gravitre.app

# Note: FASTAPI_BASE_URL is a frontend (Vercel) variable — not read by this backend.
# Note: LANGFUSE_* is not used in this codebase.

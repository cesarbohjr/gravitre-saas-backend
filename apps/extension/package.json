{
  "name": "gravitre-extension",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && vite build --mode content",
    "preview:ui": "vite --port 5199",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.564.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/chrome": "^0.1.30",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vite": "^7.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

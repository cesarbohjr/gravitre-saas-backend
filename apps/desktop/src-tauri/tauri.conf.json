{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gravitre",
  "version": "0.3.0",
  "identifier": "app.gravitre.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Gravitre",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": true,
        "center": true,
        "skipTaskbar": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://gravitre.app https://*.gravitre.app https://*.supabase.co https://*.up.railway.app https://api.github.com http://localhost:* ws://localhost:*; img-src 'self' data: https:; media-src 'self' blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Gravitre for desktop",
    "longDescription": "Ask, talk to your agents, follow assignments and approve what they ask to do, from your desktop.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "gravitre"
        ]
      }
    }
  }
}

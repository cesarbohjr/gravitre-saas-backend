# Gravitre web environment (Next.js)
# Copy to `.env.local` and fill in real values. Never commit the real .env.local.

# Supabase (required, public — exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Project Settings → API → anon public key

# Backend proxy target for /api/* route handlers and rewrites (required)
FASTAPI_BASE_URL=http://127.0.0.1:8000

# OpenAI (required for the /api/chat assistant; uses the direct OpenAI provider)
OPENAI_API_KEY=

# Gravitre web environment (Next.js)
# Copy to `.env.local` and fill in real values. Never commit the real .env.local.

# Supabase (required, public — exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Project Settings → API → anon public key

# Canonical app URL (auth redirects, middleware canonicalization)
NEXT_PUBLIC_APP_URL=https://gravitre.app

# Backend proxy target for /api/* route handlers (required on Vercel)
# Local: http://localhost:8000 (also the code default in lib/backend-proxy.ts /
# next.config.mjs when unset). Start FastAPI with `pnpm run dev:backend` or
# `pnpm run dev:full` from the repo root — marketplace catalog calls fail with
# "Failed to load marketplace catalog" if this host is unreachable.
# Production: Railway host until api.gravitre.app DNS points at Railway.
FASTAPI_BASE_URL=http://localhost:8000

# Optional: public API base for client-side references (webhooks, docs)
# Leave unset in production — browser calls should stay same-origin (/api/*) so the
# Next.js BFF adds auth + x-org-id and proxies to FASTAPI_BASE_URL server-side.
# NEXT_PUBLIC_API_URL defaults to {NEXT_PUBLIC_APP_URL}/api

# Optional: server-only Supabase admin (used by lib/supabase/server.ts for SSR)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=       # Project Settings → API → service_role key (keep secret)

# Optional: mirror Railway INTERNET_RESEARCH_ENABLED on pricing/billing UI (default on)
# NEXT_PUBLIC_INTERNET_RESEARCH_ENABLED=false
# NEXT_PUBLIC_STRIPE_PRICE_ID_NODE_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ID_CONTROL_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ID_COMMAND_MONTHLY=price_...

# Optional: marketing/docs code samples only (not used by runtime app routes)
# GRAVITRE_API_KEY=
# GRAVITRE_ORG_ID=

{
  "name": "gravitre-operator-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:full": "node scripts/dev.mjs",
    "dev": "cd apps/web && pnpm dev",
    "hubspot:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-hubspot-app.ps1",
    "hubspot:railway": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-railway-operator-env.ps1",
    "hubspot:fill-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fill-hubspot-operator-env.ps1",
    "hubspot:open": "cd integrations/hubspot-app && hs project open",
    "generate:connector-key": "node backend/scripts/generate-connector-encryption-key.mjs",
    "hubspot:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-hubspot-oauth.ps1",
    "oauth:check-all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-all-oauth-status.ps1",
    "operator:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init-operator-platform.ps1",
    "jira:fill-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fill-jira-operator-env.ps1",
    "quickbooks:railway": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-railway-operator-env.ps1",
    "quickbooks:fill-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fill-quickbooks-operator-env.ps1",
    "quickbooks:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-quickbooks-oauth.ps1",
    "jira:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-jira-oauth.ps1",
    "pagerduty:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-pagerduty-oauth.ps1",
    "google:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-google-oauth.ps1",
    "google:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-google-cloud.ps1",
    "google:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-google-platform.ps1",
    "google:fill-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fill-google-operator-env.ps1",
    "google:railway": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-railway-operator-env.ps1",
    "google:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-google-oauth.ps1",
    "auth:sync-urls": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-supabase-auth-urls.ps1",
    "auth:supabase-google": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-supabase-google.ps1",
    "platform:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-platform-cli.ps1",
    "platform:github-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-github-secrets.ps1",
    "auth:sync-jwt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-supabase-jwt-secret.ps1"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.195",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.194",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.11.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tw-animate-css": "^1.4.0"
